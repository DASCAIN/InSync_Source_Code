# Django Settings
DEBUG=False
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=your-domain.com,www.your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com
HTTPS=True

# Optional. Leave unset to use the local SQLite database.
DATABASE_URL=

# CORS should normally be false for same-origin Django templates.
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://your-domain.com

# AI Services (Voice Tutor / Chat)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_API_URL=https://api.elevenlabs.io/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_REALTIME_TRANSCRIPTION_LANGUAGE=en
OPENAI_REALTIME_TRANSCRIPTION_PROMPT=
OPENAI_REALTIME_INPUT_NOISE_REDUCTION=near_field
MEM0_API_KEY=
MEM0_USER_ID=

# RAG Settings (OpenAI, HeyGen, Qdrant, Inngest)
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-large
LLM_MODEL=gpt-4o-mini
CHUNK_SIZE=512
CHUNK_OVERLAP=50
MAX_UPLOAD_SIZE_MB=50
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=Daisy_public_20220914
HEYGEN_VOICE_ID=114a2824b75f49639e1556ae8cb45b81

# QDRANT_URL=http://localhost:6333  # Uncomment for Qdrant server
# If QDRANT_URL is not set, it will use local file storage in QDRANT_PATH (defaults to qdrant_storage)
QDRANT_PATH=qdrant_storage
INNGEST_EVENT_KEY=local
INNGEST_SIGNING_KEY=local
